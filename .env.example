# Copy this file to .env to use local configuration.
# Values already set in the terminal take precedence.
# .env and GEF_data/ must not be committed to GitHub.

# Development defaults
GEF_PRODUCTION=0
GEF_DATA_DIR=./GEF_data
GEF_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Leave empty in development to create a random key in GEF_data/.server-key.
# Production requires a private key containing at least 40 characters.
GEF_SECRET_KEY=

# Empty means SQLite. PostgreSQL also requires psycopg[binary].
DATABASE_URL=

# HTTPS production domain and trusted reverse proxy
GEF_CSRF_ORIGINS=
GEF_TRUST_PROXY=0

# Shared Redis cache is recommended for multiple WSGI workers; requires redis.
GEF_CACHE_URL=

# Map, route and address providers
GEF_ROUTER_URL=https://router.project-osrm.org
GEF_GEOCODER_URL=https://nominatim.openstreetmap.org
GEF_CONTACT=
GEF_TILE_LIGHT=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEF_TILE_DARK=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
# Leave empty to use the application's default provider attribution.
GEF_TILE_ATTRIBUTION=

# Optional OpenAI-compatible AI provider; no key means the local assistant.
GEF_AI_URL=https://api.openai.com/v1/chat/completions
GEF_AI_KEY=
GEF_AI_MODEL=
